# Optional genuine Hegemon SDK; keeps the proven Classic build separate.
enable_language(C)
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/upstream/cmake/MicroPython.cmake" mp_cmake)
string(REPLACE "\${CMAKE_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}/upstream" mp_cmake "${mp_cmake}")
if(EMSCRIPTEN)
 string(REPLACE "\"\${OPENSE4_MICROPYTHON_DIR}/shared/runtime/gchelper_generic.c\"" "\"${CMAKE_CURRENT_SOURCE_DIR}/wasm/micropython_gc.c\"" mp_cmake "${mp_cmake}")
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/micropython.cmake" "${mp_cmake}")
include("${CMAKE_CURRENT_BINARY_DIR}/micropython.cmake")
add_library(hegemon_crypto STATIC third_party/monocypher/monocypher-4.0.2/src/monocypher.c)
target_include_directories(hegemon_crypto PUBLIC third_party/monocypher/monocypher-4.0.2/src)
add_library(hegemon_zip STATIC third_party/miniz/miniz.c)
target_include_directories(hegemon_zip PUBLIC third_party/miniz)
target_compile_definitions(hegemon_zip PUBLIC MINIZ_NO_STDIO MINIZ_NO_TIME)
function(embed_python folder name)
 file(GLOB_RECURSE paths RELATIVE "${CMAKE_CURRENT_SOURCE_DIR}/upstream/${folder}" CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/upstream/${folder}/*.py")
 if(name STREQUAL "sdk_package")
  list(FILTER paths INCLUDE REGEX "^opense4/")
 endif()
 list(SORT paths)
 list(JOIN paths "|" files)
 set(output "${CMAKE_CURRENT_BINARY_DIR}/generated/${name}.cpp")
 if(name STREQUAL "sdk_package")
  set(extra "-DHEADER=sdk/players.hpp" "-DNAMESPACE=opense4::sdk" "-DFUNCTION=packageFiles")
 endif()
 execute_process(COMMAND "${CMAKE_COMMAND}" "-DOUTPUT=${output}" "-DROOT=${CMAKE_CURRENT_SOURCE_DIR}/upstream/${folder}" "-DFILES=${files}" ${extra} -P "${CMAKE_CURRENT_SOURCE_DIR}/upstream/cmake/EmbedPython.cmake" COMMAND_ERROR_IS_FATAL ANY)
 target_sources(engine PRIVATE "${output}")
endfunction()
embed_python(python/lib script_library)
embed_python(python sdk_package)
file(GLOB mod_sources CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/upstream/src/mods/*.cpp")
file(GLOB learn_sources CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/upstream/src/learn/*.cpp")
target_sources(engine PRIVATE ${mod_sources}
 upstream/src/script/runtime.cpp upstream/src/script/port/port.c
 upstream/src/sdk/generators.cpp upstream/src/sdk/parts.cpp upstream/src/sdk/player_check.cpp
 upstream/src/sdk/player_values.cpp upstream/src/sdk/players.cpp upstream/src/sdk/queries.cpp
 upstream/src/sdk/rules_api.cpp upstream/src/sdk/rules_check.cpp upstream/src/sdk/rules_effects.cpp
 upstream/src/sdk/rules_engine.cpp upstream/src/sdk/rules_view.cpp upstream/src/sdk/scenario.cpp
 upstream/src/sdk/view.cpp wasm/sdk_worker.cpp)
target_link_libraries(engine PUBLIC opense4_micropython hegemon_crypto hegemon_zip)
target_compile_definitions(opense4 PRIVATE OPENSE4_ENABLE_HEGEMON)
if(EMSCRIPTEN)
 target_link_options(opense4 PRIVATE -O2 --emit-symbol-map -sSUPPORT_LONGJMP=emscripten -sASYNCIFY=1 -sASYNCIFY_STACK_SIZE=1048576)
 set_target_properties(opense4 PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/web/engine-hegemon")
