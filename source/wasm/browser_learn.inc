// Use the upstream lesson parser, setup and condition tracker rather than a browser imitation.
std::optional<learn::Library> learningLibrary;
std::unique_ptr<learn::LessonProgress> lessonProgress;
learn::Library& lessons(){if(!learningLibrary)learningLibrary=learn::loadLibrary(learn::DirectorySource(root/"Learn"));return *learningLibrary;}
Value learnCatalog(){auto tutorials=Value::emptyList(),training=Value::emptyList(),manual=Value::emptyList();for(const auto& l:lessons().tutorials)tutorials.push(Value(ValueMap{{"id",l.slug},{"title",l.title},{"summary",l.summary}}));for(const auto& l:lessons().training)training.push(Value(ValueMap{{"id",l.slug},{"title",l.title},{"summary",l.summary}}));for(const auto& m:lessons().manual)manual.push(Value(ValueMap{{"id",m.slug},{"title",m.doc.title},{"text",learn::plainText(m.doc.blocks)}}));return Value(ValueMap{{"tutorials",tutorials},{"training",training},{"manual",manual}});}
Value learningStatus(const Value& args){if(!lessonProgress)return Value();learn::ClientFacts facts;auto window=text(args,"window","main");facts.openWindows={"main",window};if(auto selected=args.find("selected");selected&&selected->isString())facts.selected.push_back(selected->asString());facts.selectedVehicle=VehicleId{static_cast<uint32_t>(number(args,"vehicle",1000000))};facts.selections=number(args,"selections",0);if(auto components=args.find("components");components&&components->isInt())facts.designComponents=components->asInt();facts.designHullChosen=number(args,"components",0)>0;facts.designNamed=true;facts.designType=text(args,"designType","Attack Ship");facts.designVehicle="ship";facts.picking=text(args,"picking");lessonProgress->update(*rules,*state,viewer,facts);const auto operation=text(args,"operation");if(operation=="next")lessonProgress->goNext(*rules,*state,viewer);if(operation=="back")lessonProgress->goBack();if(operation=="skip")lessonProgress->skip(*rules,*state,viewer);const auto& l=lessonProgress->lesson();auto steps=Value::emptyList(),objectives=Value::emptyList(),pages=Value::emptyList();for(const auto& step:l.steps)steps.push(Value(ValueMap{{"title",step.title},{"text",learn::plainText(step.text)}}));for(size_t i=0;i<l.objectives.size();++i)objectives.push(Value(ValueMap{{"text",l.objectives[i].text},{"done",lessonProgress->objectiveDone(i)},{"failed",lessonProgress->objectiveFailed(i)}}));for(const auto& page:l.pages)if(page.turn<=state->turn)pages.push(Value(ValueMap{{"title",page.title},{"text",learn::plainText(page.text)}}));return Value(ValueMap{{"title",l.title},{"id",l.slug},{"kind",std::string(learn::kindName(l.kind))},{"step",static_cast<int>(lessonProgress->step())},{"steps",steps},{"objectives",objectives},{"pages",pages},{"canNext",lessonProgress->canGoNext()},{"finished",lessonProgress->result()!=learn::LessonProgress::Result::None},{"result",static_cast<int>(lessonProgress->result())},{"why",lessonProgress->why()}});}
