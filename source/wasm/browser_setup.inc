// Browser adapter to the original eight-page setup model. GPL-3.0.
namespace setup = client::classic::setup;
Value setupFields(GameOptions& o,const Value* input=nullptr){auto out=Value::emptyList();
auto integer=[&](const char* key,const char* page,auto& target,int lo,int hi){if(input)if(auto p=input->find(key)){if(!p->isInt()||p->asInt()<lo||p->asInt()>hi)throw std::runtime_error(std::string(key)+" is out of range");target=static_cast<std::remove_reference_t<decltype(target)>>(p->asInt());}out.push(Value(ValueMap{{"key",key},{"page",page},{"type","number"},{"value",target},{"min",lo},{"max",hi}}));};
auto boolean=[&](const char* key,const char* page,bool& target){if(input)if(auto p=input->find(key)){if(!p->isBool())throw std::runtime_error(std::string(key)+" must be true or false");target=p->asBool();}out.push(Value(ValueMap{{"key",key},{"page",page},{"type","checkbox"},{"value",target}}));};
integer("systemCount","Quadrant",o.systemCount,0,200);
integer("quadrantSize","Quadrant",o.quadrantSize,0,2);
integer("eventFrequency","Events",o.eventFrequency,0,3);
integer("maxEventSeverity","Events",o.maxEventSeverity,0,3);
integer("techCost","Technology",o.techCost,0,2);
integer("startTechLevel","Technology",o.startTechLevel,0,2);
integer("racialPoints","Player Settings",o.racialPoints,0,5000);
integer("homePlanetValue","Player Settings",o.homePlanetValue,0,2);
integer("startingPlanets","Player Settings",o.startingPlanets,1,10);
integer("aiDifficulty","Players",o.aiDifficulty,0,2);
integer("aiBonus","Players",o.aiBonus,0,4);
integer("scoreDisplay","Game Settings",o.scoreDisplay,0,2);
integer("maxShipsPerPlayer","Game Settings",o.maxShipsPerPlayer,100,20000);
integer("maxUnitsPerPlayer","Game Settings",o.maxUnitsPerPlayer,100,20000);
integer("autosaveTurns","Mechanics",o.autosaveTurns,0,10);
boolean("allWarpPointsConnected","Quadrant",o.allWarpPointsConnected);
boolean("noWarpPoints","Quadrant",o.noWarpPoints);
boolean("warpPointsAnywhere","Quadrant",o.warpPointsAnywhere);
boolean("allSystemsSeen","Quadrant",o.allSystemsSeen);
boolean("omnipresent","Quadrant",o.omnipresent);
boolean("finiteResources","Quadrant",o.finiteResources);
boolean("allPlanetsSameSize","Player Settings",o.allPlanetsSameSize);
boolean("sameSystemAllowed","Player Settings",o.sameSystemAllowed);
boolean("evenlyDistributed","Player Settings",o.evenlyDistributed);
boolean("noTacticalCombat","Game Settings",o.noTacticalCombat);
boolean("splitConstruction","Game Settings",o.splitConstruction);
boolean("completeTechTree","Game Settings",o.completeTechTree);
boolean("allowGifts","Game Settings",o.allowGifts);
boolean("allowTechTrades","Game Settings",o.allowTechTrades);
boolean("allowIntel","Game Settings",o.allowIntel);
boolean("noRuins","Game Settings",o.noRuins);
boolean("onlyBreathable","Game Settings",o.onlyBreathable);
boolean("onlyHomeType","Game Settings",o.onlyHomeType);
boolean("teamMode","Game Settings",o.teamMode);
boolean("allowSurrender","Game Settings",o.allowSurrender);
boolean("playersCanSaveMap","Game Settings",o.playersCanSaveMap);
boolean("score","Victory Conditions",o.victory.score);
boolean("years","Victory Conditions",o.victory.years);
boolean("percentOfSecond","Victory Conditions",o.victory.percentOfSecond);
boolean("techPercent","Victory Conditions",o.victory.techPercent);
boolean("peace","Victory Conditions",o.victory.peace);
boolean("delay","Victory Conditions",o.victory.delay);
integer("scoreValue","Victory Conditions",o.victory.scoreValue,200000,10000000);
integer("yearsTurns","Victory Conditions",o.victory.yearsTurns,30,5000);
integer("percentOfSecondValue","Victory Conditions",o.victory.percentOfSecondValue,150,1000);
integer("techPercentValue","Victory Conditions",o.victory.techPercentValue,10,100);
integer("peaceTurns","Victory Conditions",o.victory.peaceTurns,2,100);
integer("delayTurns","Victory Conditions",o.victory.delayTurns,10,1000);
boolean("simultaneous","Mechanics",o.simultaneous);
return out;}