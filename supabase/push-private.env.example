# Example only. Generate real keys with scripts/create-push-keys.mjs outside this folder.
VAPID_PUBLIC_KEY=GENERATED_PUBLIC_KEY
VAPID_PRIVATE_KEY=GENERATED_PRIVATE_KEY
PUSH_WORKER_SECRET=GENERATED_RANDOM_SECRET
